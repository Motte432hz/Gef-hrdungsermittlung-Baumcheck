{
  "version": "1.0",
  "hazards": [
    {
      "id": "sooty_bark",
      "title": "Rußrindenkrankheit",
      "text": "Erreger Cryptostroma corticale, vor allem am Berg-Ahorn. Unter abplatzender Rinde liegen schwarze, staubende Sporenlager. Eingeatmete Sporen können eine schwere Lungenentzündung (Alveolitis) auslösen. Befallene Bäume sterben ab, das Holz wird schnell brüchig.",
      "advice": {
        "general": "Bei Verdacht: Atemschutz mindestens FFP2, besser FFP3, Einweg-Schutzanzug und Schutzbrille. Möglichst bei feuchtem Wetter arbeiten, Unbeteiligte fernhalten.",
        "climbing": "Absterbende, befallene Kronen nicht ungeprüft besteigen – Bruchgefahr. Hubarbeitsbühne bevorzugen.",
        "felling": "Staubentwicklung vermeiden, befallene Stammteile nicht unnötig zersägen.",
        "chipping": "Befallenes Material nicht in Wohnnähe hacken; beim Transport abdecken und nach örtlichen Vorgaben entsorgen."
      }
    },
    {
      "id": "oak_processionary",
      "title": "Eichenprozessionsspinner",
      "text": "Die Brennhaare der Raupen (etwa Mai bis Juli) und alte Gespinstnester lösen Hautausschlag sowie Augen- und Atemwegsreizungen aus – auch noch Monate bis Jahre später.",
      "advice": {
        "general": "Krone vor Arbeitsbeginn auf Nester und Raupen absuchen. Bei Befall nur mit Schutzausrüstung (Schutzanzug, Atemschutz FFP2/FFP3, Schutzbrille, Handschuhe) arbeiten oder die Bekämpfung durch eine Fachfirma abwarten.",
        "climbing": "Nester nicht berühren; Seile und Ausrüstung nach dem Einsatz reinigen, Kleidung getrennt waschen.",
        "chipping": "Nester und befallenes Material nicht hacken, sondern gesondert entsorgen."
      }
    },
    {
      "id": "ash_dieback",
      "title": "Eschentriebsterben",
      "text": "Pilz Hymenoscyphus fraxineus. Kronen sterben ab, oft mit Stammfußnekrosen und Wurzelfäule (häufig Hallimasch). Befallene Eschen können ohne äußere Vorwarnung umstürzen oder abbrechen; totes Eschenholz wird schnell spröde.",
      "advice": {
        "climbing": "Stammfuß und Wurzelanlauf vor dem Aufstieg genau prüfen (Rindennekrosen, Pilze, Klopfprobe). Bei deutlichem Befall nicht besteigen – Hubarbeitsbühne oder Kran verwenden.",
        "felling": "Die Bruchleiste kann versagen, die Fällrichtung ist unsicher: Seilzug oder Seilwinde einsetzen und den Sicherheitsabstand vergrößern.",
        "rigging": "Anschlag- und Umlenkpunkte in geschädigten Kronen nicht belasten."
      }
    },
    {
      "id": "barber_chair",
      "title": "Aufreißgefahr beim Fällen",
      "text": "Das Holz neigt beim Fällen dazu, längs aufzureißen und nach oben herauszuschlagen – besonders bei Vorhängern.",
      "advice": {
        "felling": "Bei Vorhang eine geeignete Fälltechnik mit Halteband und Stechschnitt verwenden, den Stamm bei Bedarf vorher mit Kette oder Gurt umschlingen. Rückweiche frei halten und sofort nutzen."
      }
    },
    {
      "id": "massaria",
      "title": "Massaria-Krankheit",
      "text": "Pilz Splanchnonema platani an Platanen. Befällt meist die Oberseite von Ästen: Rinde rötlich bis violett verfärbt, darunter stirbt ein Holzstreifen ab. Befallene Äste können innerhalb weniger Monate plötzlich abbrechen und sind von unten oft kaum zu erkennen.",
      "advice": {
        "climbing": "Äste von oben bzw. aus der Hubarbeitsbühne kontrollieren, bevor sie als Anschlag- oder Standpunkt dienen.",
        "pruning": "Befallene Äste vorrangig entfernen; Fallbereich großzügig absperren."
      }
    },
    {
      "id": "irritant_hairs",
      "title": "Reizende Haare und Staub",
      "text": "Feine Sternhaare an jungen Blättern und Fruchtständen lösen Husten sowie Augen- und Hautreizungen aus, besonders im Frühjahr und beim Zerfall der Fruchtkugeln.",
      "advice": {
        "general": "Schutzbrille und Staubmaske (FFP2) tragen.",
        "chipping": "Beim Hacken auf Staubentwicklung achten, Windrichtung berücksichtigen."
      }
    },
    {
      "id": "summer_drop",
      "title": "Grünastbruch (Sommerbruch)",
      "text": "An heißen, meist windstillen Sommertagen können gesund aussehende, waagerechte Starkäste ohne Vorwarnung abbrechen.",
      "advice": {
        "general": "Fallbereich im Sommer auch während Pausen abgesperrt lassen.",
        "climbing": "Lange, waagerechte Starkäste nicht als Anschlagpunkt nutzen; nicht unter langen Seitenästen aufhalten.",
        "pruning": "Lange Hebel durch Einkürzen entlasten."
      }
    },
    {
      "id": "brittle_wood",
      "title": "Bruchanfälliges Holz",
      "text": "Das Holz ist weich oder spröde. Äste und Zwiesel brechen leichter als bei anderen Arten, oft ohne Vorwarnung.",
      "advice": {
        "climbing": "Anschlagpunkt besonders tragfähig wählen (möglichst am Stamm oder starken Stämmling) und Redundanz einplanen.",
        "rigging": "Nur kleine Stücke abseilen, Umlenkpunkte nicht überlasten, Fallstrecke kurz halten."
      }
    },
    {
      "id": "heavy_deadwood",
      "title": "Schweres Totholz",
      "text": "Abgestorbene Starkäste sind schwer und bleiben lange in der Krone. Sie brechen bei Erschütterungen durch Seilarbeit oder Fällung.",
      "advice": {
        "climbing": "Totholz im Kletterweg zuerst entfernen oder umgehen.",
        "felling": "Beim Fällschnitt nach oben sehen und die Rückweiche sofort nutzen."
      }
    },
    {
      "id": "heavy_wood",
      "title": "Hohes Holzgewicht",
      "text": "Das Holz ist sehr schwer; Äste und Stammteile wiegen deutlich mehr als geschätzt.",
      "advice": {
        "rigging": "Gewicht vorher abschätzen (Frischholz bis etwa 1 t pro m³), Abseilsystem und Anschlagpunkt entsprechend auslegen, kürzere Stücke schneiden."
      }
    },
    {
      "id": "beech_fungi",
      "title": "Stammfuß- und Wurzelpilze",
      "text": "Brandkrustenpilz (Kretzschmaria deusta) und Riesenporling (Meripilus giganteus) zersetzen Stammfuß und Wurzeln. Bäume können trotz voller Belaubung plötzlich umbrechen (Sprödbruch).",
      "advice": {
        "climbing": "Stammfuß rundum prüfen (schwarze Krusten, Fruchtkörper, Klopfprobe). Bei Befund nicht besteigen.",
        "felling": "Bei Fäule am Stammfuß versagt die Bruchleiste: Fällrichtung mit Seilzug sichern, Fällung gegebenenfalls maschinell."
      }
    },
    {
      "id": "slippery_bark",
      "title": "Glatte Rinde",
      "text": "Die glatte Rinde ist bei Nässe sehr rutschig.",
      "advice": {
        "climbing": "Bei Nässe besonders auf sicheren Halt achten und durchgehend am Seil gesichert bleiben."
      }
    },
    {
      "id": "rapid_decay",
      "title": "Schnelle Zersetzung nach dem Absterben",
      "text": "Abgestorbenes Holz wird innerhalb kurzer Zeit morsch. Tote oder stark geschwächte Bäume sind sehr bruchgefährdet.",
      "advice": {
        "climbing": "Abgestorbene Bäume nicht besteigen – Hubarbeitsbühne einsetzen oder vom Boden fällen.",
        "felling": "Tote Bäume brechen beim Fällen unkontrolliert, die Krone kann abbrechen: Seilzug einsetzen, nach oben sichern."
      }
    },
    {
      "id": "shallow_roots",
      "title": "Flachwurzler – Windwurfgefahr",
      "text": "Flaches Wurzelsystem: Bei Wind, nassem Boden oder Wurzelschäden ist die Umsturzgefahr hoch.",
      "advice": {
        "general": "Nicht bei starkem Wind arbeiten; Wurzelteller auf Risse und Anheben prüfen."
      }
    },
    {
      "id": "bark_beetle",
      "title": "Borkenkäfer",
      "text": "Befallene Fichten (Bohrmehl, abfallende Rinde, verfärbte Nadeln) sterben schnell ab; Wipfel und Äste werden brüchig.",
      "advice": {
        "climbing": "Abgestorbene oder stark befallene Fichten nicht besteigen.",
        "general": "Befallenes Holz zügig aus dem Bestand bringen."
      }
    },
    {
      "id": "conifer_root_rot",
      "title": "Wurzel- und Stammfußfäule",
      "text": "Hallimasch und Wurzelschwamm (Heterobasidion) verursachen Fäule im Wurzel- und Stammfußbereich – von außen oft nicht zu sehen.",
      "advice": {
        "climbing": "Stammfuß prüfen, auf Harzfluss und Fruchtkörper am Stammfuß achten.",
        "felling": "Fäule im Fällschnitt kann die Bruchleiste schwächen; Fällrichtung zusätzlich sichern."
      }
    },
    {
      "id": "resin",
      "title": "Harz",
      "text": "Starker Harzfluss verklebt Seile, Handschuhe und Werkzeug und macht Griffe rutschig.",
      "advice": {
        "general": "Ausrüstung nach dem Einsatz reinigen, Seile auf Verklebungen prüfen."
      }
    },
    {
      "id": "toxic",
      "title": "Giftige Pflanzenteile",
      "text": "Teile des Baumes sind giftig (siehe Hinweis zur Art). Gefahr vor allem beim Verschlucken; Säge- und Hackstaub kann Haut und Atemwege reizen.",
      "advice": {
        "general": "Handschuhe tragen, während der Arbeit nicht essen oder rauchen, danach Hände waschen. Schnittgut nicht auf Weiden liegen lassen und nicht an Tiere verfüttern (Pferde, Rinder, Schafe).",
        "chipping": "Hackgut nicht als Einstreu oder Futter abgeben."
      }
    },
    {
      "id": "thorns",
      "title": "Dornen und stechende Blätter",
      "text": "Dornen oder stechende Blätter verletzen Haut und Augen und können Seile, Gurte und Kleidung beschädigen.",
      "advice": {
        "general": "Visier bzw. Schutzbrille geschlossen halten, feste Handschuhe tragen.",
        "climbing": "Seile und Gurte nicht über Dornen führen, Seile nach dem Einsatz prüfen."
      }
    },
    {
      "id": "skin_sap",
      "title": "Hautreizender Pflanzensaft",
      "text": "Saft oder Pflanzenteile können Haut und Augen reizen oder Allergien auslösen.",
      "advice": {
        "general": "Hautkontakt vermeiden: lange Ärmel, Handschuhe, Schutzbrille."
      }
    },
    {
      "id": "bleeding_canker",
      "title": "Rindenkrankheit mit Schleimfluss",
      "text": "Bakterielle Rindenkrankheit (Pseudomonas syringae pv. aesculi) mit dunklen, blutenden Rindenstellen. Darunter folgen rasch Holzfäule und Astbrüche.",
      "advice": {
        "climbing": "Befallene Stämme und Äste nicht als Anschlagpunkt nutzen.",
        "pruning": "Abgestorbene Kronenteile vorrangig entfernen."
      }
    },
    {
      "id": "hollows",
      "title": "Neigung zu Höhlungen",
      "text": "Die Art bildet häufig Stamm- und Asthöhlungen (Kernfäule). Viele Bäume bleiben lange stabil – entscheidend ist die verbleibende Restwand.",
      "advice": {
        "climbing": "Anschlagpunkt und Stämmlinge auf Höhlungen prüfen (Klopfprobe, Löcher, Spechthöhlen).",
        "felling": "Höhlungen schwächen die Bruchleiste – Fälltechnik anpassen, das Halteband kann versagen."
      }
    },
    {
      "id": "included_bark",
      "title": "Neigung zu Druckzwieseln",
      "text": "Die Art bildet häufig Zwiesel mit eingewachsener Rinde, die unter Last aufreißen können.",
      "advice": {
        "climbing": "Anschlagpunkt nicht über einem Druckzwiesel wählen; Zwiesel bei Bedarf mit Rundschlinge sichern.",
        "pruning": "Druckzwiesel bei Einkürzung und Kronensicherung berücksichtigen."
      }
    },
    {
      "id": "honeydew",
      "title": "Honigtau",
      "text": "Blattläuse scheiden klebrigen Honigtau aus. Rinde, Ausrüstung und Boden werden klebrig und rutschig.",
      "advice": {
        "general": "Rutschgefahr auf Wegen und Leitern beachten, Ausrüstung reinigen."
      }
    },
    {
      "id": "elm_disease",
      "title": "Ulmensterben",
      "text": "Pilzkrankheit (Holländische Ulmenkrankheit). Abgestorbene Ulmen und Kronenteile werden spröde und brechen leicht.",
      "advice": {
        "climbing": "Abgestorbene Kronenteile nicht belasten."
      }
    },
    {
      "id": "chestnut_blight",
      "title": "Kastanienrindenkrebs",
      "text": "Pilz Cryphonectria parasitica. Rindenkrebs lässt Äste und Kronenteile absterben, die dann brechen können.",
      "advice": {
        "climbing": "Abgestorbene Kronenteile nicht als Anschlag- oder Standpunkt nutzen."
      }
    },
    {
      "id": "very_tall",
      "title": "Sehr große Bäume",
      "text": "Die Art erreicht große Höhen; Fallbereich und Rettungswege sind entsprechend groß.",
      "advice": {
        "climbing": "Das Rettungsseil muss von der höchsten Arbeitsposition bis zum Boden reichen. Verständigung über große Höhe per Funk sicherstellen.",
        "felling": "Fallbereich mindestens doppelte Baumlänge; oft ist stückweise Abtragung nötig."
      }
    },
    {
      "id": "heavy_limbs",
      "title": "Schwere, weit ausladende Äste",
      "text": "Lange, schwere Seitenäste mit großer Hebelwirkung.",
      "advice": {
        "rigging": "Äste in Stücken abseilen und Pendelbewegungen einplanen.",
        "pruning": "Lange Hebel schrittweise einkürzen statt am Stamm abzusetzen."
      }
    }
  ],
