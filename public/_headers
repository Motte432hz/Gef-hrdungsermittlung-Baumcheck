# Cloudflare Pages response headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()

# Hashed build files never change → cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must always be revalidated, otherwise updates arrive late.
/sw.js
  Cache-Control: no-cache
